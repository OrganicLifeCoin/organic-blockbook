# Use testnet until the complete explorer flow passes release checks.
NETWORK=testnet

# Connect to an OrganicLifeCoin node on a private network.
NODE_RPC_HOST=host.docker.internal
RPC_USER=replace-user
RPC_PASSWORD=replace-password

# Keep these values empty to use the selected network defaults.
NODE_RPC_PORT=
NODE_ZMQ_PORT=

# Set a host to receive real-time node notifications.
NODE_ZMQ_HOST=host.docker.internal

# Publish only to the local gateway host.
PUBLIC_PORT=9130

# Bound node and indexer work.
RPC_TIMEOUT=25
MEMPOOL_WORKERS=8
MEMPOOL_SUB_WORKERS=2
BLOCK_ADDRESSES_TO_KEEP=300
